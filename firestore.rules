rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if true;
    }

    match /examSessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
